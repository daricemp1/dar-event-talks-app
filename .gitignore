# Gitignore for common files

# Operating System Files
.DS_Store
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
npm-shrinkwrap.json

# IDEs and Editors
.idea/
.vscode/
*.swp
*.bak
*.swo

# Build artifacts
dist/
build/
*.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Others
*.sublime-project
*.sublime-workspace
